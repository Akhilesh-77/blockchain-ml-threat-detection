# ==============================================================================
# CyberNex — Configuration File
# ==============================================================================

CYBERNEX_HOST=127.0.0.1
CYBERNEX_PORT=8000
CYBERNEX_ENV=development

# Database configuration (defaults to SQLite local database)
DATABASE_URL=sqlite:///./cyber_nex.db

# Blockchain Proof-of-Work difficulty target (default: 2 leading zeros)
BLOCKCHAIN_DIFFICULTY=2

# Allowed CORS origins for Next.js web application
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

